# Copy this file to .env and fill these from your actual Clerk development tenant.
# Leave blank to run the app with the protected Live API locked.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
HONEYPROBE_ALLOWED_EMAILS=

# Optional, comma-separated exact IP addresses of trusted reverse-proxy peers.
HONEYPROBE_TRUSTED_PROXY_IPS=

# Optional local web port override. The API gateway is not published to the host.
HONEYPROBE_WEB_PORT=5000
